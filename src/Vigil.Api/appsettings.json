{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Rules": {
    "Path": "config/rules.v2.json"
  },
  "Llm": {
    "Provider": "Fake",
    "InputPricePer1kTokens": 0.0003,
    "OutputPricePer1kTokens": 0.0012
  },
  "Investigation": {
    "Enabled": true,
    "DailyLimit": 20
  }
}

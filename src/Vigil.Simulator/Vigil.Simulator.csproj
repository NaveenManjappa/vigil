<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vigil.ServiceDefaults\Vigil.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Vigil.Domain\Vigil.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied beside the binary so the AppHost's Start button finds them whatever the working directory. -->
    <None Include="..\..\scenarios\*.json" LinkBase="scenarios" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
